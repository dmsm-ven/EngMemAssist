<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Только ради NotifyIcon (значок в трее). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
	<PublishReadyToRun>true</PublishReadyToRun>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Неявные using от WinForms конфликтуют с WPF (Application, MessageBox, Color...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngMemAssist.Core\EngMemAssist.Core.csproj" />
    <ProjectReference Include="..\EngMemAssist.Data\EngMemAssist.Data.csproj" />
    <ProjectReference Include="..\EngMemAssist.Integrations\EngMemAssist.Integrations.csproj" />
    <ProjectReference Include="..\EngMemAssist.Nlp\EngMemAssist.Nlp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

</Project>
