<UserControl x:Class="EngMemAssist.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:EngMemAssist.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="680" Margin="0,0,16,0" HorizontalAlignment="Left">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="EngMemAssist" />
        <TextBlock Margin="0,4,0,24" Opacity="0.7" Text="Личный помощник по запоминанию английских слов" />

        <ui:Card Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing Width="24" Height="24" Margin="0,0,12,0" IsIndeterminate="True"
                                     Visibility="{Binding Sync.IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Sync.Status}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Opacity="0.7" Text="{Binding Summary}" />
            </StackPanel>
        </ui:Card>

        <StackPanel Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Padding="24,10" Appearance="Primary" Command="{Binding StartQuizCommand}" Content="Начать квиз" />
            <ui:Button Margin="0,0,8,0" Padding="16,10" Command="{Binding SyncCommand}" Content="Синхронизировать" />
            <ui:Button Padding="16,10" Command="{Binding ConnectCommand}" Content="Подключить таблицу"
                       Visibility="{Binding Sync.IsNotConfigured, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <local:RecentSessionsView Height="280" Margin="0,24,0,0" DataContext="{Binding RecentSessions}" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
