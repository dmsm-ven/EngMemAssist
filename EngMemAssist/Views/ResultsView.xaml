<UserControl x:Class="EngMemAssist.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:infra="clr-namespace:EngMemAssist.Infrastructure">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Неверные ответы подсвечиваются в каждой колонке (без переопределения стиля строки WPF-UI). -->
        <Style x:Key="ResultTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCorrect}" Value="False">
                    <Setter Property="Foreground" Value="#E57373" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CorrectTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ResultTextStyle}">
            <Setter Property="ToolTip" Value="{Binding AllTranslations, StringFormat='Все верные варианты: {0}'}" />
        </Style>
        <Style x:Key="HintIconStyle" TargetType="TextBlock" BasedOn="{StaticResource ResultTextStyle}">
            <Setter Property="ToolTip" Value="{Binding HintDescription}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" infra:PageScroll.ForwardWheel="True">
            <StackPanel Margin="0,0,16,0">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SummaryText}" />
                <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding Subtitle}"
                           Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}" />

                <!-- Итог в виде рассказа -->
                <ui:Card Margin="0,16,0,16" Padding="20">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="36" Text="{Binding Story.Emoji}" />
                            <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Story.Headline}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Story.Paragraphs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,8" FontSize="15" TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <ui:CardExpander Margin="0,0,0,16" Header="Подробный разбор" IsExpanded="{Binding IsHistory, Mode=OneWay}">
                    <DataGrid MaxHeight="380" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" ItemsSource="{Binding Result.Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="Auto" Header="№" Binding="{Binding Number}" ElementStyle="{StaticResource ResultTextStyle}" />
                            <DataGridTextColumn Width="Auto" Header="" Binding="{Binding ResultMark}" ElementStyle="{StaticResource ResultTextStyle}" />
                            <DataGridTextColumn Width="Auto" Header="Подсказка" Binding="{Binding HintIcon}" ElementStyle="{StaticResource HintIconStyle}" />
                            <DataGridTextColumn Width="*" Header="Слово" Binding="{Binding English}" ElementStyle="{StaticResource ResultTextStyle}" />
                            <DataGridTextColumn Width="*" Header="Ваш ответ" Binding="{Binding Chosen}" ElementStyle="{StaticResource ResultTextStyle}" />
                            <DataGridTextColumn Width="*" Header="Правильный вариант" Binding="{Binding CorrectOption}" ElementStyle="{StaticResource CorrectTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:CardExpander>

                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="AgainButton" Margin="0,0,8,0" Padding="24,10" Appearance="Primary" Command="{Binding AgainCommand}" Content="Ещё раз" />
                    <ui:Button Margin="0,0,8,0" Padding="16,10" Command="{Binding HomeCommand}" Content="На главную" />
                    <ui:Button Padding="16,10" Command="{Binding BackToStatsCommand}" Content="К статистике"
                               Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</UserControl>
