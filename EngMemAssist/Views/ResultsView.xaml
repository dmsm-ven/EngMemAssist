<UserControl x:Class="EngMemAssist.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Неверные ответы подсвечиваются в каждой колонке (без переопределения стиля строки WPF-UI). -->
        <Style x:Key="ResultTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCorrect}" Value="False">
                    <Setter Property="Foreground" Value="#E57373" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SummaryText}" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding Subtitle}"
                       Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" CanUserAddRows="False" ItemsSource="{Binding Result.Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="Auto" Header="№" Binding="{Binding Number}" ElementStyle="{StaticResource ResultTextStyle}" />
                <DataGridTextColumn Width="Auto" Header="" Binding="{Binding ResultMark}" ElementStyle="{StaticResource ResultTextStyle}" />
                <DataGridTextColumn Width="*" Header="Слово" Binding="{Binding English}" ElementStyle="{StaticResource ResultTextStyle}" />
                <DataGridTextColumn Width="*" Header="Ваш ответ" Binding="{Binding Chosen}" ElementStyle="{StaticResource ResultTextStyle}" />
                <DataGridTextColumn Width="*" Header="Правильный вариант" Binding="{Binding CorrectOption}" ElementStyle="{StaticResource ResultTextStyle}" />
                <DataGridTextColumn Width="2*" Header="Все переводы" Binding="{Binding AllTranslations}" ElementStyle="{StaticResource ResultTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Padding="24,10" Appearance="Primary" Command="{Binding AgainCommand}" Content="Ещё раз" />
            <ui:Button Margin="0,0,8,0" Padding="16,10" Command="{Binding HomeCommand}" Content="На главную" />
            <ui:Button Padding="16,10" Command="{Binding BackToStatsCommand}" Content="К статистике"
                       Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
