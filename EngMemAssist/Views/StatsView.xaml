<UserControl x:Class="EngMemAssist.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:infra="clr-namespace:EngMemAssist.Infrastructure">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Клетка карты активности: пустые дни серые, остальные — акцентный цвет разной насыщенности -->
        <Style x:Key="HeatCellStyle" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding CellOpacity}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="0">
                    <Setter Property="Background" Value="#33808080" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFuture}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" infra:PageScroll.ForwardWheel="True">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Margin="0,0,0,16" FontSize="24" FontWeight="SemiBold" Text="Статистика" />

                <!-- Прогресс изучения -->
                <ui:CardExpander Margin="0,0,0,8" Header="Прогресс изучения" IsExpanded="True">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{Binding ProgressText}" />
                        <ProgressBar Height="14" Margin="0,0,0,16" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />

                        <ItemsControl ItemsSource="{Binding StageSummaries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,8,8" Padding="12,8" ToolTip="{Binding Description}">
                                        <StackPanel>
                                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Count}" />
                                            <TextBlock Opacity="0.7" Text="{Binding Title}" />
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Карта активности -->
                <ui:CardExpander Margin="0,0,0,8" Header="Активность" IsExpanded="True">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Opacity="0.7" Text="{Binding ActivityText}" />
                        <ItemsControl ItemsSource="{Binding HeatmapWeeks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HeatCellStyle}" ToolTip="{Binding Tooltip}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Общая статистика -->
                <ui:CardExpander Margin="0,0,0,8" Header="Общая статистика">
                    <UniformGrid Columns="4">
                        <ui:Card Margin="0,0,8,0" Padding="12">
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Overview.SessionsCount}" />
                                <TextBlock Opacity="0.7" Text="тестов пройдено" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,8,0" Padding="12">
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Overview.AnswersCount}" />
                                <TextBlock Opacity="0.7" Text="ответов всего" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,8,0" Padding="12">
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Overview.CorrectPercent, StringFormat={}{0:0}%}" />
                                <TextBlock Opacity="0.7" Text="верных ответов" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Overview.ActiveWords}" />
                                <TextBlock Opacity="0.7" Text="слов в словаре" />
                            </StackPanel>
                        </ui:Card>
                    </UniformGrid>
                </ui:CardExpander>

                <!-- Самые трудные слова -->
                <ui:CardExpander Margin="0,0,0,8" Header="Самые трудные слова">
                    <DataGrid MaxHeight="320" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" ItemsSource="{Binding HardestWords}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Слово" Binding="{Binding English}" />
                            <DataGridTextColumn Width="*" Header="Перевод" Binding="{Binding Translation}" />
                            <DataGridTextColumn Width="Auto" Header="Ошибок" Binding="{Binding ErrorPercentText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:CardExpander>

                <!-- Статистика по всем словам -->
                <ui:CardExpander Margin="0,0,0,8" Header="Статистика по всем словам">
                    <DataGrid MaxHeight="420" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" ItemsSource="{Binding WordStats}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Слово" Binding="{Binding English}" />
                            <DataGridTextColumn Width="Auto" Header="Стадия" Binding="{Binding StageText}" />
                            <DataGridTextColumn Width="Auto" Header="Верно" Binding="{Binding CorrectCount}" />
                            <DataGridTextColumn Width="Auto" Header="Ошибок" Binding="{Binding WrongCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="48" Height="48" IsIndeterminate="True" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.7" Text="Загрузка…" />
        </StackPanel>
    </Grid>
</UserControl>
