<Window x:Class="EngMemAssist.Views.ReminderToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="380"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Topmost="True"
        WindowStyle="None">

    <Border Margin="14" Padding="16" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.4" ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top"
                   Source="pack://application:,,,/Assets/app.ico" />
            <StackPanel Grid.Column="1">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Время повторить слова" />
                <TextBlock Margin="0,4,0,12" Opacity="0.7" TextWrapping="Wrap"
                           Text="Мини-тест из 5 вопросов — займёт меньше минуты." />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="Пройти" Click="OnAccept" />
                    <ui:Button Content="Позже" Click="OnSnooze" />
                </StackPanel>
            </StackPanel>
            <ui:Button Grid.Column="2" VerticalAlignment="Top" Padding="6" ToolTip="Закрыть"
                       Icon="{ui:SymbolIcon Dismiss16}" Click="OnDismiss" />
        </Grid>
    </Border>
</Window>
