<UserControl x:Class="EngMemAssist.Views.RecentSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext — RecentSessionsViewModel (задаётся страницей-хозяином) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Последние тесты (нажмите, чтобы открыть результаты)" />
        <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" SelectionMode="Single" ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Дата" Binding="{Binding StartedAtLocal}" />
                <DataGridTextColumn Width="Auto" Header="Результат" Binding="{Binding ScoreText}" />
                <DataGridTextColumn Width="Auto" Header="Подсказок" Binding="{Binding HintsUsed}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
