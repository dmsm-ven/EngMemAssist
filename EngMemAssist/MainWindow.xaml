<ui:FluentWindow
    x:Class="EngMemAssist.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="clr-namespace:EngMemAssist.Infrastructure"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:EngMemAssist.Views"
    xmlns:vm="clr-namespace:EngMemAssist.ViewModels"
    Title="EngMemAssist"
    Width="1000"
    Height="640"
    MinWidth="800"
    MinHeight="520"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToAppearanceConverter x:Key="ActiveAppearance" />

        <!--  ViewModel -> View: страницы подбираются автоматически  -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuizViewModel}">
            <views:QuizView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WordsViewModel}">
            <views:WordsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <views:StatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Фон на всё окно: цветная подложка и картинка с заданной непрозрачностью  -->
        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="-1"
            IsHitTestVisible="False"
            Visibility="{Binding Background.HasImage, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="{Binding Background.OverlayBrush}" />
            <Rectangle Fill="{Binding Background.ImageBrush}" Opacity="{Binding Background.ImageOpacity}" />
        </Grid>

        <ui:TitleBar Title="EngMemAssist" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="12" IsEnabled="{Binding IsNavigationEnabled}">
                <ui:Button
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Appearance="{Binding IsHomeActive, Converter={StaticResource ActiveAppearance}}"
                    Command="{Binding ShowHomeCommand}"
                    Content="Главная" />
                <ui:Button
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Appearance="{Binding IsWordsActive, Converter={StaticResource ActiveAppearance}}"
                    Command="{Binding ShowWordsCommand}"
                    Content="Список слов" />
                <ui:Button
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Appearance="{Binding IsStatsActive, Converter={StaticResource ActiveAppearance}}"
                    Command="{Binding ShowStatsCommand}"
                    Content="Статистика" />
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Appearance="{Binding IsSettingsActive, Converter={StaticResource ActiveAppearance}}"
                    Command="{Binding ShowSettingsCommand}"
                    Content="Настройки" />
            </StackPanel>

            <ContentControl
                Grid.Column="1"
                Margin="16"
                Content="{Binding Navigation.Current}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
