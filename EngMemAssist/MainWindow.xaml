<ui:FluentWindow x:Class="EngMemAssist.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:EngMemAssist.ViewModels"
                 xmlns:views="clr-namespace:EngMemAssist.Views"
                 xmlns:infra="clr-namespace:EngMemAssist.Infrastructure"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Title="EngMemAssist"
                 Width="1000"
                 Height="640"
                 MinWidth="800"
                 MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <infra:BoolToAppearanceConverter x:Key="ActiveAppearance" />

        <!-- ViewModel -> View: страницы подбираются автоматически -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuizViewModel}">
            <views:QuizView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WordsViewModel}">
            <views:WordsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <views:StatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="EngMemAssist" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="12">
                <ui:Button Margin="0,0,0,8" HorizontalAlignment="Stretch" Command="{Binding ShowHomeCommand}" Content="Главная"
                           Appearance="{Binding IsHomeActive, Converter={StaticResource ActiveAppearance}}" />
                <ui:Button Margin="0,0,0,8" HorizontalAlignment="Stretch" Command="{Binding ShowWordsCommand}" Content="Список слов"
                           Appearance="{Binding IsWordsActive, Converter={StaticResource ActiveAppearance}}" />
                <ui:Button Margin="0,0,0,8" HorizontalAlignment="Stretch" Command="{Binding ShowStatsCommand}" Content="Статистика"
                           Appearance="{Binding IsStatsActive, Converter={StaticResource ActiveAppearance}}" />
                <ui:Button HorizontalAlignment="Stretch" Command="{Binding ShowSettingsCommand}" Content="Настройки"
                           Appearance="{Binding IsSettingsActive, Converter={StaticResource ActiveAppearance}}" />
            </StackPanel>

            <ContentControl Grid.Column="1" Margin="16" Content="{Binding Navigation.Current}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
