<Project>
  <!-- Central Package Management: версии пакетов задаются только здесь. -->
  <!-- ВАЖНО: версии Catalyst и Google.Apis выставлены по памяти (NuGet из среды генерации недоступен).
       NuGet берёт ближайшую доступную версию не ниже указанной; если restore всё же ругается — поправьте здесь. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="dbup-sqlite" Version="6.0.4" />
    <PackageVersion Include="Catalyst" Version="26.10.6514" />
    <PackageVersion Include="Catalyst.Models.English" Version="26.9.5316" />
    <PackageVersion Include="Google.Apis.Sheets.v4" Version="1.77.0.4290" />
  </ItemGroup>
</Project>